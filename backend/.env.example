# Copy to .env and supply your own credentials. Never commit .env.
NODE_ENV=development
PORT=3000
# Optional: comma-separated IP addresses of trusted reverse proxies, not clients.
TRUST_PROXY_IPS=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Generate a random secret; production requires at least 32 characters.
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
